{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["**/self-built/images/csi-driver-iscsi/**"],
  "kubernetes": {
    "managerFilePatterns": ["/^(?:apps|infra|monitoring)/.*\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(?:^|/).+-values\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s+(?:-\\s+|[A-Za-z_][A-Za-z0-9_]*=)?[\\\"']?https://github\\.com/[^/]+/[^/]+/releases/download/(?<currentValue>[^/]+)/"
      ],
      "description": "Update GitHub release download URLs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+version:\\s+[\\\"']?(?<currentValue>[^\\\"'\\s#]+)[\\\"']?"
      ],
      "description": "Update version fields with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+tag:\\s+(?<currentValue>\\S+)"
      ],
      "description": "Update tag fields with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+value: \"(?<currentValue>[^\"]+)\""
      ],
      "description": "Update env var values with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n(?<depKey>talosVersion|kubernetesVersion):\\s+(?<currentValue>\\S+)"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n{{{depKey}}}: {{{newValue}}}",
      "description": "Update Talos and Kubernetes versions in talhelper config"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\nappVersion:\\s+[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ],
      "description": "Update appVersion in Chart.yaml and track upstream image"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "description": "Update version arguments in Dockerfiles"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["infra/**", "monitoring/**", "clusters/**"],
      "addLabels": ["infrastructure"]
    },
    {
      "matchFileNames": ["apps/**"],
      "addLabels": ["apps"]
    },
    {
      "matchFileNames": ["self-built/**"],
      "addLabels": ["self-built"]
    },
    {
      "description": "Group dependencies by self-built project",
      "matchFileNames": ["self-built/**"],
      "groupName": "self-built dependencies in {{packageFileDir}}",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["kube-prometheus-stack"],
      "postUpgradeTasks": {
        "commands": [
          "python3 -c \"import urllib.request,json,re; d=json.loads(urllib.request.urlopen('https://artifacthub.io/api/v1/packages/helm/prometheus-community/kube-prometheus-stack/{{newVersion}}').read()); ver=d.get('app_version'); f='infra/monitoring-crds/kustomization.yaml'; c=open(f).read(); open(f,'w').write(re.sub(r'download/v[0-9.]+/stripped',f'download/{ver}/stripped',c)) if ver else None\""
        ],
        "fileFilters": ["infra/monitoring-crds/kustomization.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchPackageNames": ["mongo"],
      "allowedVersions": "/^(?:4\\.4|7\\.0)\\./",
      "groupName": "MongoDB patch versions"
    },
    {
      "description": "Allow SiYuan semantic releases through v99 and ignore legacy v100/v103 tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/apkdv/siyuan-unlock"],
      "allowedVersions": "/^v(?:[0-9]|[1-9][0-9])\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["J0R6IT0/navidrome-lyrics-plugin"],
      "postUpgradeTasks": {
        "commands": [
          "python3 -c \"import hashlib,re,urllib.request; f='apps/music/navidrome-deployment.yaml'; c=open(f).read(); u=re.search(r'https://github\\.com/J0R6IT0/navidrome-lyrics-plugin/releases/download/[^/]+/nd-lyrics\\.ndp',c).group(0); h=hashlib.sha256(urllib.request.urlopen(u).read()).hexdigest(); c=re.sub(r'plugin_sha256=\\\"[0-9a-f]{64}\\\"','plugin_sha256=\\\"'+h+'\\\"',c); open(f,'w').write(c)\""
        ],
        "fileFilters": ["apps/music/navidrome-deployment.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/Chart.yaml"],
      "automerge": true,
      "automergeType": "branch",
      "postUpgradeTasks": {
        "commands": [
          "python3 -c \"import re; f=open('{{packageFile}}'); c=f.read(); f.close(); m=re.search(r'^version: (\\d+)\\.(\\d+)\\.(\\d+)', c, re.M); c2=(c[:m.start()]+'version: '+m.group(1)+'.'+m.group(2)+'.'+str(int(m.group(3))+1)+c[m.end():]) if m else c; open('{{packageFile}}','w').write(c2)\""
        ],
        "fileFilters": ["**/Chart.yaml"],
        "executionMode": "update"
      }
    }
  ]
}
