{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["**/self-built/images/csi-driver-iscsi/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s+-\\s+https://github\\.com/[^/]+/[^/]+/releases/download/(?<currentValue>[^/]+)/"
      ],
      "description": "Update GitHub release download URLs in Kustomization files"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+version:\\s+(?<currentValue>\\S+)"
      ],
      "description": "Update version fields with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+tag:\\s+(?<currentValue>\\S+)"
      ],
      "description": "Update tag fields with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s+value: \"(?<currentValue>[^\"]+)\""
      ],
      "description": "Update env var values with renovate comment"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n(?<depKey>talosVersion|kubernetesVersion):\\s+(?<currentValue>\\S+)"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n{{{depKey}}}: {{{newValue}}}",
      "description": "Update Talos and Kubernetes versions in talhelper config"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\nappVersion:\\s+[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ],
      "description": "Update appVersion in Chart.yaml and track upstream image"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["infra/**", "monitoring/**", "clusters/**"],
      "addLabels": ["infrastructure"]
    },
    {
      "matchFileNames": ["apps/**"],
      "addLabels": ["apps"]
    },
    {
      "matchFileNames": ["self-built/**"],
      "addLabels": ["self-built"]
    },
    {
      "matchPackageNames": ["kube-prometheus-stack"],
      "postUpgradeTasks": {
        "commands": [
          "python3 -c \"import urllib.request,json,re; d=json.loads(urllib.request.urlopen('https://artifacthub.io/api/v1/packages/helm/prometheus-community/kube-prometheus-stack/{{newVersion}}').read()); ver=d.get('app_version'); f='infra/monitoring-crds/kustomization.yaml'; c=open(f).read(); open(f,'w').write(re.sub(r'download/v[0-9.]+/stripped',f'download/{ver}/stripped',c)) if ver else None\""
        ],
        "fileFilters": ["infra/monitoring-crds/kustomization.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["**/Chart.yaml"],
      "automerge": true,
      "automergeType": "branch",
      "postUpgradeTasks": {
        "commands": [
          "python3 -c \"import re; f=open('{{packageFile}}'); c=f.read(); f.close(); m=re.search(r'^version: (\\d+)\\.(\\d+)\\.(\\d+)', c, re.M); c2=(c[:m.start()]+'version: '+m.group(1)+'.'+m.group(2)+'.'+str(int(m.group(3))+1)+c[m.end():]) if m else c; open('{{packageFile}}','w').write(c2)\""
        ],
        "fileFilters": ["**/Chart.yaml"],
        "executionMode": "update"
      }
    }
  ]
}
